# ==========================================
# PODOLOG KUTSYTOI — ЕДИНЫЙ ENV ДЛЯ ВСЕГО ПРОЕКТА
# Copy this file to .env in the PROJECT ROOT.
# This single .env is used by:
# - backend/NestJS
# - Android/iOS run scripts
# - release build scripts
# - Telegram/YCLIENTS/content admin checks
#
# MODES:
# 1) Laptop real integrations now:
#    APP_ENV=local, AUTH_MODE=local_demo, STORAGE_DRIVER=json, FILE_STORAGE_DRIVER=telegram,
#    REAL YCLIENTS + REAL TELEGRAM, but demo SMS/domain/push/Postgres.
#    Use: powershell -NoProfile -ExecutionPolicy Bypass -File .\START_LAPTOP_REAL_INTEGRATIONS.ps1
# 2) Store/server production later:
#    APP_ENV=production, AUTH_MODE=sms_ru, STORAGE_DRIVER=postgres, HTTPS domains, real SMS and legal URLs.
#    Use: powershell -NoProfile -ExecutionPolicy Bypass -File .\scripts\CHECK_PRODUCTION_READY.ps1
# ==========================================

# ===== APP MODE =====
APP_ENV=local
RUN_MODE=laptop_real_integrations
APP_OPERATING_MODEL=thin_proxy
# thin_proxy = current release plan: app UI + YCLIENTS as CRM + Telegram as chat/media archive. full = own backend/base/media.
AUTH_MODE=local_demo
LOCAL_DEMO_CODE=1111
PORT=3000
API_BASE_URL=http://127.0.0.1:3000
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3000
CORS_ORIGIN=*
APP_JWT_SECRET=local-dev-only-secret-change-before-release-32chars
AUTH_CODE_TTL_SECONDS=300
AUTH_TOKEN_TTL_SECONDS=2592000
BOOKING_CANCEL_BEFORE_HOURS=48

# ===== STORAGE =====
# local/dev: json + local media.
# full production: postgres + s3.
# thin_proxy production: postgres recommended for technical indexes; FILE_STORAGE_DRIVER=telegram keeps Telegram as media archive.
STORAGE_DRIVER=json
FILE_STORAGE_DRIVER=telegram
BOOKING_PROVIDER=yclients
PROFILE_PROVIDER=app_cache
CHAT_PROVIDER=telegram
CHAT_WEBSOCKET_ENABLE=false
CHAT_HISTORY_MODE=technical_index
CHAT_MEDIA_PRIMARY=telegram
TELEGRAM_MEDIA_CACHE_RETENTION_HOURS=168
DATABASE_URL=postgresql://podolog:change_me_password@localhost:5432/podolog
DATABASE_SSL=false
DATABASE_POOL_MAX=10
RUN_DB_MIGRATIONS_ON_START=true
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# ===== HIDDEN STORE REVIEW / TEST MODE =====
TEST_MODE_ENABLED=false
TEST_MODE_FIRST_NAME=Тест
TEST_MODE_LAST_NAME=Маркет
TEST_MODE_PHONE=+79990000000

# ===== MOBILE ID / RELEASE =====
ANDROID_APPLICATION_ID=ru.podology.moscow.client
IOS_BUNDLE_ID=ru.podology.moscow.client
APP_DISPLAY_NAME=PODOLOG KUTSYTOI
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
PRIVACY_POLICY_URL=https://podologkutsytoi.com/legal/privacy
TERMS_URL=https://podologkutsytoi.com/legal/terms
ACCOUNT_DELETION_URL=https://podologkutsytoi.com/legal/account-deletion
SUPPORT_EMAIL=danilova.danilova.99@mail.ru

# ===== SMS AUTH =====
# Laptop mode uses demo SMS code 1111. Production requires real SMS_RU_API_ID and AUTH_MODE=sms_ru.
SMS_PROVIDER=demo
SMS_DEMO_MODE=true
SMS_RU_API_ID=local_demo_sms_not_required_on_laptop

# ===== CONTENT ADMIN =====
CONTENT_ADMIN_TOKEN=local-content-admin-token-change-before-release

# ===== TELEGRAM ADMIN BOT =====
TELEGRAM_ADMIN_ENABLE=true
TELEGRAM_ADMIN_BOT_TOKEN=put_admin_bot_token_from_botfather_here
TELEGRAM_ADMIN_IDS=put_telegram_admin_user_id_here

# ===== TELEGRAM CHAT BOT =====
TELEGRAM_ENABLE_NOTIFICATIONS=true
TELEGRAM_SYSTEM_EVENTS_TO_TELEGRAM=false
TELEGRAM_CHAT_BRIDGE_ENABLE=true
TELEGRAM_CHAT_BOT_TOKEN=put_chat_bot_token_from_botfather_here
TELEGRAM_CHAT_GROUP_ID=put_telegram_forum_group_id_here
TELEGRAM_CHAT_TOPICS_ENABLED=true
TELEGRAM_CHAT_REQUIRE_TOPICS=true

# ===== YCLIENTS / ALTEGIO =====
YCLIENTS_API_BASE_URL=https://api.yclients.com/api/v1
YCLIENTS_LOCALE=ru-RU
YCLIENTS_PARTNER_TOKEN=put_partner_token_here
YCLIENTS_USER_TOKEN=put_user_token_here
YCLIENTS_COMPANY_ID=put_company_id_here
YCLIENTS_FORM_ID=put_form_id_here

# Legacy/manual maps are intentionally unused in the live CRM flow.
# The backend reads real service/staff IDs directly from YCLIENTS and passes them to the app.
YCLIENTS_SERVICE_ID_MAP={}
YCLIENTS_STAFF_ID_MAP={}
YCLIENTS_CREATE_BOOKING_ENDPOINT_TEMPLATE=/book_record/{companyId}/
YCLIENTS_CANCEL_METHOD=DELETE
YCLIENTS_CANCEL_ENDPOINT_TEMPLATE=/record/{companyId}/{recordId}
# Thin backend configurable endpoints. Leave empty until real YCLIENTS/Altegio API access is confirmed.
YCLIENTS_BOOKINGS_ENDPOINT_TEMPLATE=
YCLIENTS_CLIENT_UPSERT_ENDPOINT_TEMPLATE=
YCLIENTS_CLIENT_DELETE_ENDPOINT_TEMPLATE=
YCLIENTS_CLIENT_DELETE_MODE=request

# ===== LAPTOP REAL INTEGRATIONS MODE =====
# This is the current recommended mode while there is no server/domain/SMS provider yet.
# APP_ENV=local
# RUN_MODE=laptop_real_integrations
# AUTH_MODE=local_demo
# LOCAL_DEMO_CODE=1111
# STORAGE_DRIVER=json
# FILE_STORAGE_DRIVER=telegram
# BOOKING_PROVIDER=yclients
# PROFILE_PROVIDER=app_cache
# CHAT_PROVIDER=telegram
# REAL: YCLIENTS_* and TELEGRAM_*
# DEMO/LOCAL: SMS, domain URLs, push, PostgreSQL.

# ===== PRODUCTION MINIMUM CHANGES — FULL MODE =====
# APP_ENV=production
# AUTH_MODE=sms_ru
# STORAGE_DRIVER=postgres
# FILE_STORAGE_DRIVER=s3
# API_BASE_URL=https://api.podologkutsytoi.com
# APP_PUBLIC_BASE_URL=https://api.podologkutsytoi.com
# MEDIA_PUBLIC_BASE_URL=https://cdn.podologkutsytoi.com
# APP_JWT_SECRET=<random 64+ chars>
# DATABASE_URL=<production postgres url>
# Fill SMS, S3, Telegram, YCLIENTS, legal URLs and SUPPORT_EMAIL.

# ===== PRODUCTION MINIMUM CHANGES — THIN YCLIENTS/TELEGRAM MODE =====
# APP_ENV=production
# APP_OPERATING_MODEL=thin_proxy
# AUTH_MODE=sms_ru
# BOOKING_PROVIDER=yclients
# PROFILE_PROVIDER=app_cache
# CHAT_PROVIDER=telegram
# CHAT_HISTORY_MODE=technical_index
# CHAT_MEDIA_PRIMARY=telegram
# STORAGE_DRIVER=postgres
# FILE_STORAGE_DRIVER=telegram
# API_BASE_URL=https://api.podologkutsytoi.com
# APP_PUBLIC_BASE_URL=https://api.podologkutsytoi.com
# MEDIA_PUBLIC_BASE_URL=https://api.podologkutsytoi.com
# APP_JWT_SECRET=<random 64+ chars>
# DATABASE_URL=<small production postgres url for sessions/consents/chat indexes>
# Fill SMS, Telegram, YCLIENTS, legal URLs and SUPPORT_EMAIL. S3 is not required in thin mode.
ALLOW_DEMO_YCLIENTS=false
YCLIENTS_SYNC_ENABLE=true
YCLIENTS_IMPORTANT_EVENTS_TO_TELEGRAM=true
YCLIENTS_CATALOG_EVENTS_TO_TELEGRAM=false
YCLIENTS_CACHE_LAST_GOOD=true
YCLIENTS_BOOKINGS_LOOKBACK_DAYS=30
YCLIENTS_BOOKINGS_LOOKAHEAD_DAYS=90
YCLIENTS_DATES_FALLBACK_DAYS=30

# ===== V11 SAFETY LAYER =====
# Backend checks the slot again before creating a real YCLIENTS record.
# This prevents stale mobile state after salon changes service price/duration/staff/schedule.
BOOKING_QUOTE_TTL_MINUTES=3
YCLIENTS_BOOTSTRAP_HORIZON_DAYS=30
YCLIENTS_BOOTSTRAP_SERVICE_LIMIT=40
YCLIENTS_BOOTSTRAP_SERVICE_CONCURRENCY=4
YCLIENTS_BOOTSTRAP_STAFF_CONCURRENCY=4
YCLIENTS_BOOTSTRAP_TIMES_CONCURRENCY=24
YCLIENTS_BOOTSTRAP_REQUEST_TIMEOUT_MS=3000
YCLIENTS_BOOTSTRAP_TIMES_PER_DAY=24
# Optional hidden/test admin endpoint can retry failed Telegram deliveries:
# POST /telegram/retry-undelivered with test-mode auth.
TELEGRAM_RETRY_UNDELIVERED_ENABLED=false
