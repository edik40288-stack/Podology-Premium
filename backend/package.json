{
  "name": "podology-premium-backend",
  "version": "0.3.18",
  "private": true,
  "description": "Backend for PODOLOG KUTSYTOI: cleaned V16 laptop-real quick run with YCLIENTS services/staff/times booking flow and Telegram bridge.",
  "scripts": {
    "start": "node ./node_modules/@nestjs/cli/bin/nest.js start",
