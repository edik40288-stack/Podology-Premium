# PODOLOG KUTSYTOI — LAPTOP_REAL_INTEGRATIONS MODE
# Purpose: run on a Windows laptop/phone with REAL YCLIENTS + REAL TELEGRAM,
# while SMS, domain, HTTPS, push and PostgreSQL are still local/demo.
# Copy to .env OR run scripts\SWITCH_TO_LAPTOP_REAL_INTEGRATIONS.ps1.

# ===== MODE =====
APP_ENV=local
RUN_MODE=laptop_real_integrations
APP_OPERATING_MODEL=thin_proxy
AUTH_MODE=local_demo
LOCAL_DEMO_CODE=1111
PORT=3000
API_BASE_URL=http://127.0.0.1:3000
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3000
CORS_ORIGIN=*
APP_JWT_SECRET=CHANGE_ME_GENERATED_BY_SWITCH_SCRIPT_OR_RANDOM_64_CHARS
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_RATE_MAX=50
AUTH_CODE_RATE_WINDOW_SECONDS=900
AUTH_TOKEN_TTL_SECONDS=2592000
BOOKING_CANCEL_BEFORE_HOURS=48

# ===== LOCAL TECH STORAGE =====
STORAGE_DRIVER=json
FILE_STORAGE_DRIVER=telegram
BOOKING_PROVIDER=yclients
PROFILE_PROVIDER=app_cache
CHAT_PROVIDER=telegram
CHAT_WEBSOCKET_ENABLE=false
CHAT_HISTORY_MODE=technical_index
CHAT_MEDIA_PRIMARY=telegram
TELEGRAM_MEDIA_CACHE_RETENTION_HOURS=168
DATABASE_URL=postgresql://local_demo_not_used:local_demo_not_used@localhost:5432/local_demo_not_used
DATABASE_SSL=false
DATABASE_POOL_MAX=10
RUN_DB_MIGRATIONS_ON_START=false

# ===== NO REAL SMS ON LAPTOP =====
SMS_PROVIDER=demo
SMS_DEMO_MODE=true
SMS_RU_API_ID=local_demo_sms_not_required_on_laptop

# ===== CONTENT ADMIN =====
CONTENT_ADMIN_TOKEN=local-content-admin-token-change-before-release

# ===== TELEGRAM ADMIN BOT — REAL =====
TELEGRAM_ADMIN_ENABLE=true
TELEGRAM_ADMIN_BOT_TOKEN=put_admin_bot_token_from_botfather_here
TELEGRAM_ADMIN_IDS=put_telegram_admin_user_id_here

# ===== TELEGRAM CHAT BOT — REAL =====
TELEGRAM_ENABLE_NOTIFICATIONS=true
TELEGRAM_SYSTEM_EVENTS_TO_TELEGRAM=false
TELEGRAM_CHAT_BRIDGE_ENABLE=true
TELEGRAM_CHAT_BOT_TOKEN=put_chat_bot_token_from_botfather_here
TELEGRAM_CHAT_GROUP_ID=put_telegram_forum_group_id_here
TELEGRAM_CHAT_TOPICS_ENABLED=true
TELEGRAM_CHAT_REQUIRE_TOPICS=true
TELEGRAM_RETRY_UNDELIVERED_ENABLED=true

# ===== YCLIENTS / ALTEGIO — REAL =====
YCLIENTS_API_BASE_URL=https://api.yclients.com/api/v1
YCLIENTS_LOCALE=ru-RU
YCLIENTS_PARTNER_TOKEN=put_partner_token_here
YCLIENTS_USER_TOKEN=put_user_token_here
YCLIENTS_COMPANY_ID=put_company_id_here
YCLIENTS_FORM_ID=put_form_id_here
YCLIENTS_CREATE_BOOKING_ENDPOINT_TEMPLATE=/book_record/{companyId}/
YCLIENTS_CANCEL_METHOD=DELETE
YCLIENTS_CANCEL_ENDPOINT_TEMPLATE=/record/{companyId}/{recordId}
YCLIENTS_BOOKINGS_ENDPOINT_TEMPLATE=
YCLIENTS_CLIENT_UPSERT_ENDPOINT_TEMPLATE=
YCLIENTS_CLIENT_DELETE_ENDPOINT_TEMPLATE=
YCLIENTS_CLIENT_DELETE_MODE=request
ALLOW_DEMO_YCLIENTS=false
YCLIENTS_SYNC_ENABLE=true
YCLIENTS_IMPORTANT_EVENTS_TO_TELEGRAM=true
YCLIENTS_CATALOG_EVENTS_TO_TELEGRAM=false
YCLIENTS_CACHE_LAST_GOOD=true
YCLIENTS_BOOKINGS_LOOKBACK_DAYS=30
YCLIENTS_BOOKINGS_LOOKAHEAD_DAYS=90
YCLIENTS_DATES_FALLBACK_DAYS=30
BOOKING_QUOTE_TTL_MINUTES=3
YCLIENTS_BOOTSTRAP_HORIZON_DAYS=30
YCLIENTS_BOOTSTRAP_SERVICE_LIMIT=40
YCLIENTS_BOOTSTRAP_SERVICE_CONCURRENCY=4
YCLIENTS_BOOTSTRAP_STAFF_CONCURRENCY=4
YCLIENTS_BOOTSTRAP_TIMES_CONCURRENCY=24
YCLIENTS_BOOTSTRAP_REQUEST_TIMEOUT_MS=3000
YCLIENTS_BOOTSTRAP_TIMES_PER_DAY=24

# ===== MOBILE / LEGAL PLACEHOLDERS FOR LOCAL RUN =====
ANDROID_APPLICATION_ID=ru.podology.moscow.client
IOS_BUNDLE_ID=ru.podology.moscow.client
APP_DISPLAY_NAME=PODOLOG KUTSYTOI
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
PRIVACY_POLICY_URL=http://127.0.0.1:3000/legal/privacy-local-placeholder
TERMS_URL=http://127.0.0.1:3000/legal/terms-local-placeholder
ACCOUNT_DELETION_URL=http://127.0.0.1:3000/legal/account-deletion-local-placeholder
SUPPORT_EMAIL=danilova.danilova.99@mail.ru

# ===== DISABLED FOR LAPTOP =====
TEST_MODE_ENABLED=false
FILE_STORAGE_DRIVER_PRODUCTION_NOTE=Use s3 or telegram only after server/domain review.
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
